FROM apache/airflow:2.10.5-python3.11

USER airflow
COPY --chown=airflow:root pyproject.toml /opt/idx-platform/pyproject.toml
COPY --chown=airflow:root app /opt/idx-platform/app
WORKDIR /opt/idx-platform

# Airflow 2.10 requires SQLAlchemy 1.4 and pandas <2.2. The ETL application uses
# SQLAlchemy 2, so install it in an isolated virtual environment and invoke its
# CLI from BashOperator tasks. Never modify Airflow's own Python environment.
RUN python -m venv /opt/airflow/idx-venv \
    && /opt/airflow/idx-venv/bin/pip install --no-cache-dir .
